# Evidence image for team-demos (ai-security-demos).
# Nothing is installed. The tree holds 53 `.py` files and every module-scope
# import in them resolves to the standard library or to a sibling module inside
# the checkout (`harness`, `toolbox`, `sift_common`, `sift_memory`, `retrieve`,
# `reveal`, `send_email`, `set_ats_score`, `schedule_interview`, `_state`). The
# only third-party import anywhere is `anthropic`, in 19 files, and in all 19 it
# sits inside a function below the dry-run return. (An earlier version of this
# comment said "all 19 demo scripts": 19 is the count of files importing
# `anthropic`, not the number of scripts. See evidence ev-demos-13.) The tree
# carries no requirements file, no pyproject and no package.json.
#
# The demos call a model provider. `network_allowlist` is empty and the
# container runs with --network none, so those paths are scored from source.
# Demo 07 runs a loopback beacon server, which still works with no network.
FROM docker.io/library/python:3.12-slim
