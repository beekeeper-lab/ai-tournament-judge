{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/model-run.schema.json",
  "title": "Model execution record",
  "type": "object",
  "required": ["event_id", "run_id", "component", "component_version", "model_requested",
               "model_used", "started_at", "completed_at", "verified", "framework_commit",
               "visibility"],
  "properties": {
    "event_id": {"$ref": "common.schema.json#/$defs/slug"},
    "run_id": {"type": "string", "minLength": 1},
    "component": {"$ref": "common.schema.json#/$defs/slug"},
    "component_version": {"$ref": "common.schema.json#/$defs/reference"},
    "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/slug"}, {"type": "null"}]},
    "match_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/match_id"}, {"type": "null"}]},
    "model_requested": {"type": "string", "minLength": 1},
    "model_used": {"type": ["string", "null"]},
    "verified": {
      "type": "boolean",
      "$comment": "false means the model actually used could not be confirmed; dependent conclusions are unverified."
    },
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "completed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "framework_commit": {"$ref": "common.schema.json#/$defs/framework_commit"},
    "note": {"type": "string"},
    "visibility": {"$ref": "common.schema.json#/$defs/visibility"}
  },
  "additionalProperties": true
}
