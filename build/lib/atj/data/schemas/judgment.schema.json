{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/judgment.schema.json",
  "title": "Individual judgment",
  "$comment": "The set of criterion IDs is NOT fixed here. atj.scoring checks scores against the canonical rubric so the rubric file stays the only editable source.",
  "type": "object",
  "required": ["event_id", "team_id", "judge_id", "judge_run_id", "commit",
               "evidence_package_id", "rubric", "persona", "framework_commit",
               "scores", "visibility", "approval_state", "validation_state", "model"],
  "properties": {
    "event_id": {"$ref": "common.schema.json#/$defs/slug"},
    "team_id": {"$ref": "common.schema.json#/$defs/slug"},
    "judge_id": {"$ref": "common.schema.json#/$defs/slug"},
    "judge_run_id": {"$ref": "common.schema.json#/$defs/judge_run_id"},
    "commit": {"$ref": "common.schema.json#/$defs/commit"},
    "evidence_package_id": {"$ref": "common.schema.json#/$defs/evidence_package_id"},
    "rubric": {"$ref": "common.schema.json#/$defs/reference"},
    "persona": {"$ref": "common.schema.json#/$defs/reference"},
    "framework_commit": {"$ref": "common.schema.json#/$defs/framework_commit"},
    "scores": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "common.schema.json#/$defs/slug"},
      "additionalProperties": {
        "oneOf": [{"type": "number", "minimum": 0}, {"const": "NE"}]
      }
    },
    "confidence": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/slug"},
      "additionalProperties": {"enum": ["low", "medium", "high"]}
    },
    "visibility": {"const": "private"},
    "approval_state": {"$ref": "common.schema.json#/$defs/approval_state"},
    "validation_state": {"$ref": "common.schema.json#/$defs/validation_state"},
    "model": {"$ref": "common.schema.json#/$defs/model_record"}
  },
  "additionalProperties": true
}
