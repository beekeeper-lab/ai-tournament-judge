{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/evidence-manifest.schema.json",
  "title": "Evidence manifest",
  "type": "object",
  "required": ["event_id", "team_id", "commit", "evidence_package_id", "rubric",
               "framework_commit", "prepared_at", "execution_status", "visibility",
               "approval_state", "validation_state"],
  "properties": {
    "event_id": {"$ref": "common.schema.json#/$defs/slug"},
    "team_id": {"$ref": "common.schema.json#/$defs/slug"},
    "commit": {"$ref": "common.schema.json#/$defs/commit"},
    "evidence_package_id": {"$ref": "common.schema.json#/$defs/evidence_package_id"},
    "rubric": {"$ref": "common.schema.json#/$defs/reference"},
    "framework_commit": {"$ref": "common.schema.json#/$defs/framework_commit"},
    "prepared_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "completed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "execution_status": {
      "enum": ["not-run", "unavailable", "sandboxed-complete", "sandboxed-partial", "refused"],
      "$comment": "'unavailable' means no verified isolation was available; affected criteria must use NE."
    },
    "execution_record": {"type": ["string", "null"]},
    "visibility": {"$ref": "common.schema.json#/$defs/visibility"},
    "approval_state": {"$ref": "common.schema.json#/$defs/approval_state"},
    "validation_state": {"$ref": "common.schema.json#/$defs/validation_state"},
    "evidence_limited_criteria": {
      "type": "array", "items": {"$ref": "common.schema.json#/$defs/slug"}
    }
  },
  "additionalProperties": true
}
