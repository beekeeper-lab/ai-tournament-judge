{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/team.schema.json",
  "title": "Team intake record",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "eligible"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "affiliation_group": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_result": {
      "$ref": "common.schema.json#/$defs/previous_result"
    },
    "repository": {
      "type": "string"
    },
    "commit": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/commit"
        },
        {
          "const": ""
        }
      ]
    },
    "submitted_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "eligible": {
      "type": "boolean"
    },
    "band": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "withdrawn": {
      "type": "boolean"
    },
    "withdrawal_reason": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$comment": "repository and commit are optional until intake pins them; atj.event.validate_roster requires them from the evidence stage onward."
}
