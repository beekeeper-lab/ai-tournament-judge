{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/adjudication.schema.json",
  "title": "Adjudication record",
  "type": "object",
  "required": [
    "event_id",
    "adjudication_id",
    "scope",
    "trigger",
    "question",
    "resolution",
    "decided_by",
    "persona",
    "rubric",
    "framework_commit",
    "visibility",
    "approval_state",
    "validation_state"
  ],
  "properties": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "adjudication_id": {
      "$ref": "common.schema.json#/$defs/adjudication_id"
    },
    "scope": {
      "enum": [
        "team",
        "criterion",
        "matchup",
        "event"
      ]
    },
    "team_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "match_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/match_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "criterion": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger": {
      "enum": [
        "unresolved-ne",
        "severe-disagreement",
        "possible-outlier",
        "contradictory-facts",
        "order-disagreement",
        "close-call",
        "rules-exception",
        "security-escalation"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "evidence_reviewed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution": {
      "enum": [
        "resolved",
        "unresolved",
        "referred-to-human"
      ]
    },
    "resolution_detail": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1,
      "$comment": "A human official's role. Disqualification, unresolved ties and rules exceptions are human-only."
    },
    "persona": {
      "$ref": "common.schema.json#/$defs/reference",
      "$comment": "What produced this record, not who decided: a component registered in framework/personas.md. The deciding human is decided_by."
    },
    "rubric": {
      "$ref": "common.schema.json#/$defs/reference"
    },
    "framework_commit": {
      "$ref": "common.schema.json#/$defs/framework_commit"
    },
    "score_override": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "Never edits a judge's score. Records an additive panel-level resolution.",
      "properties": {
        "criterion": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "resolved_score": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "const": "NE"
            }
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "visibility": {
      "const": "private"
    },
    "approval_state": {
      "$ref": "common.schema.json#/$defs/approval_state"
    },
    "validation_state": {
      "$ref": "common.schema.json#/$defs/validation_state"
    },
    "advances_team": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ],
      "$comment": "For a matchup adjudication: the team the official decided advances. Read from here, never from prose."
    },
    "decision_authority": {
      "enum": [
        "human-official",
        "agent-substituted"
      ],
      "$comment": "human-official: the official named in decided_by decided, and the record may move an official total. agent-substituted: an agent stood in for a human, which is disclosed and never sufficient to move one. Absent means unknown, which is treated as insufficient: a record written before this field existed cannot retroactively claim human authority."
    },
    "substitution_reason": {
      "type": "string",
      "minLength": 1,
      "$comment": "Required when decision_authority is agent-substituted: why no human official decided, so the substitution is reviewable rather than invisible."
    },
    "amendments": {
      "type": "array",
      "$comment": "Append-only. An approved record is never silently edited; a correction is disclosed here with its own time, reason and author.",
      "items": {
        "type": "object",
        "required": [
          "amended_at",
          "reason",
          "amended_by"
        ],
        "properties": {
          "amended_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "amended_by": {
            "type": "string",
            "minLength": 1
          },
          "supersedes": {
            "type": "string",
            "$comment": "What the record said before this amendment."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "decision_authority"
        ],
        "properties": {
          "decision_authority": {
            "const": "agent-substituted"
          }
        }
      },
      "then": {
        "required": [
          "substitution_reason"
        ]
      }
    }
  ]
}
