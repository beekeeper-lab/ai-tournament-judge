{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judgment.schema.json",
  "title": "Individual Judgment",
  "type": "object",
  "required": ["event_id", "team_id", "judge_id", "commit", "evidence_package_id", "rubric", "scores"],
  "properties": {
    "event_id": {"type": "string"},
    "team_id": {"type": "string"},
    "judge_id": {"type": "string"},
    "commit": {"type": "string"},
    "evidence_package_id": {"type": "string"},
    "rubric": {"const": "submission-evaluation@1.0.0"},
    "scores": {
      "type": "object",
      "required": ["functional", "product", "agentic", "engineering", "reliability", "security", "innovation"],
      "additionalProperties": false,
      "properties": {
        "functional": {"$ref": "#/$defs/score"},
        "product": {"$ref": "#/$defs/score"},
        "agentic": {"$ref": "#/$defs/score"},
        "engineering": {"$ref": "#/$defs/score"},
        "reliability": {"$ref": "#/$defs/score"},
        "security": {"$ref": "#/$defs/score"},
        "innovation": {"$ref": "#/$defs/score"}
      }
    }
  },
  "$defs": {"score": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 5}, {"const": "NE"}]}},
  "additionalProperties": true
}
