{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/dossier.schema.json",
  "title": "Team dossier",
  "type": "object",
  "required": ["event_id", "team_id", "commit", "evidence_package_id", "rubric",
               "framework_commit", "visibility", "approval_state", "validation_state"],
  "properties": {
    "event_id": {"$ref": "common.schema.json#/$defs/slug"},
    "team_id": {"$ref": "common.schema.json#/$defs/slug"},
    "commit": {"$ref": "common.schema.json#/$defs/commit"},
    "evidence_package_id": {"$ref": "common.schema.json#/$defs/evidence_package_id"},
    "rubric": {"$ref": "common.schema.json#/$defs/reference"},
    "framework_commit": {"$ref": "common.schema.json#/$defs/framework_commit"},
    "source_reports": {"type": "array", "items": {"type": "string"}},
    "visibility": {"const": "team"},
    "approval_state": {"$ref": "common.schema.json#/$defs/approval_state"},
    "validation_state": {"$ref": "common.schema.json#/$defs/validation_state"}
  },
  "additionalProperties": true
}
