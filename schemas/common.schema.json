{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/common.schema.json",
  "title": "Shared identifier and classification definitions",
  "$comment": "Criterion IDs and weights are deliberately absent. framework/rubrics/submission-evaluation.md is their only source; atj.scoring enforces them at validation time.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "framework_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,64}|uncommitted)$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidence_package_id": {
      "type": "string",
      "pattern": "^ev:[a-z0-9-]+:[a-z0-9-]+:[0-9a-f]{12}:[0-9a-f]{8}$"
    },
    "judge_run_id": {
      "type": "string",
      "pattern": "^jr:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+:[0-9a-f]{8}:[0-9]{2}$"
    },
    "match_id": {
      "type": "string",
      "pattern": "^mu:[a-z0-9-]+:[a-z0-9-]+:[0-9]{2}$"
    },
    "adjudication_id": {
      "type": "string",
      "pattern": "^adj:[a-z0-9-]+:[a-z0-9-]+:[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "visibility": {
      "enum": [
        "private",
        "team",
        "public"
      ]
    },
    "approval_state": {
      "enum": [
        "draft",
        "pending-approval",
        "approved",
        "rejected",
        "withdrawn"
      ]
    },
    "validation_state": {
      "enum": [
        "unvalidated",
        "valid",
        "invalid"
      ]
    },
    "bye_policy": {
      "enum": [
        "performance-qualified",
        "random-lottery",
        "banded-lottery"
      ]
    },
    "previous_result": {
      "enum": [
        "champion",
        "runner-up",
        "none"
      ]
    },
    "score": {
      "$comment": "Raw criterion score on the canonical rubric scale, or the NE sentinel. The scale bounds live in the rubric; this only rejects negatives and non-numbers.",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "const": "NE"
        }
      ]
    },
    "model_record": {
      "type": "object",
      "required": [
        "model_requested",
        "model_used",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "model_requested": {
          "type": "string",
          "minLength": 1
        },
        "model_used": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "verified": {
          "type": "boolean",
          "description": "True only when the model identity was established outside the model's own statement: an orchestrator run record, a harness-reported identifier, or a recorded API response. A model's self-report is false. framework/policies/evidence-and-citation.md defines the threshold."
        },
        "note": {
          "type": "string",
          "description": "Which source established the model identity, or why none was available."
        }
      },
      "additionalProperties": true
    }
  }
}
