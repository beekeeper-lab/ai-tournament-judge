{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tournament-judge.local/schemas/roster.schema.json",
  "title": "Team roster",
  "type": "object",
  "required": ["event_id", "roster_version", "frozen", "teams"],
  "properties": {
    "event_id": {"$ref": "common.schema.json#/$defs/slug"},
    "roster_version": {"type": "integer", "minimum": 1},
    "frozen": {"type": "boolean"},
    "teams": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "team.schema.json"}
    }
  },
  "additionalProperties": true
}
